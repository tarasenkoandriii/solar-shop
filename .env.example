# ============================================================
# ЄДИНИЙ .env для всього монорепо (apps/api + apps/web + apps/admin + apps/tma)
# ============================================================
#
# Раніше кожен apps/* мав власний .env.example з частковим дублюванням
# (API_INTERNAL_URL/NEXT_PUBLIC_API_URL/NEXT_PUBLIC_ENABLE_DEV_LOGIN
# доводилось вручну тримати однаковими у 2-3 файлах одночасно) — зведено в
# один файл. Кожен застосунок сам підвантажує звідси потрібні йому змінні:
#
# - apps/api: `ConfigModule.forRoot({ envFilePath: ['.env', '../../.env'] })`
#   (apps/api/src/app.module.ts) — спочатку шукає apps/api/.env (якщо є,
#   для локального override), інакше бере корінь
# - apps/web, apps/admin, apps/tma: `next.config.mjs` кожного застосунку
#   явно підвантажує корінний .env через `dotenv` ПЕРЕД визначенням
#   nextConfig (Next.js сам за замовчуванням читає .env лише зі своєї
#   директорії, тому без цього кроку кореневий файл не побачив би)
# - docker-compose.yml лежить у цьому самому корені — docker compose й так
#   автоматично підхоплює `.env` з тієї ж директорії для `${VAR}`-підстановок
#
# **Важливо про Vercel-деплой**: усе вище — тільки для ЛОКАЛЬНОЇ розробки.
# У проді кожен з 4 застосунків — ОКРЕМИЙ Vercel-проєкт (див. README) з
# власними Environment Variables у дашборді Vercel — жоден файл на диску
# там не бере участі, Vercel сам інжектить process.env напряму. Єдиний
# файл — це зручність локальної розробки, не заміна per-project конфігурації
# на проді (Vercel фізично не вміє інакше — 4 незалежні проєкти).
#
# Скопіюй у `.env` (не в git — вже в .gitignore) і заповни реальними
# значеннями. Дефолти нижче — робочі для `docker compose up` без правок.

# ---------- apps/api (сервер, секрети — НІКОЛИ у NEXT_PUBLIC_*) ----------

# За прямим запитом користувача — "для supabase должен быть DIRECT_URL
# для конфига ORM". Supabase дає ДВА різних підключення — DATABASE_URL
# через PgBouncer-пулер (порт 6543, transaction mode, для рантайм-
# запитів застосунку) і DIRECT_URL напряму (порт 5432, для міграцій
# Prisma) — PgBouncer у transaction mode не підтримує prepared
# statements, які Prisma використовує під час `migrate`/`db push`, без
# directUrl міграції з пулера просто впадуть з помилкою. Для
# локальної розробки (docker-compose, значення нижче) пулера немає —
# обидва природно однакові.
DATABASE_URL="postgresql://dev:dev@localhost:5432/solarshop"
# На Supabase — реальні значення з Dashboard → Project Settings →
# Database → Connection string (замінити [project-ref]/[password]/
# [region] на свої):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://dev:dev@localhost:5432/solarshop"
PORT=3001
# ОБОВ'ЯЗКОВО. Без цієї змінної API не стартує — AuthModule кидає при
# запуску (аудит 27.08.2026: раніше був фолбек на константу
# 'dev-secret-change-me', тобто застосунок мовчки піднімався з секретом,
# який лежить у відкритому репозиторії, і будь-хто міг підписати собі
# токен з роллю ADMIN).
#
# Згенеруй власне значення — саме згенеруй, не придумай:
#   openssl rand -base64 48
JWT_SECRET=""

# Dev-вхід без Telegram (POST /auth/dev-login) — ТІЛЬКИ для локальної
# розробки під Docker. Працює лише при ENABLE_DEV_LOGIN=true І
# NODE_ENV != "production" одночасно (подвійний захист від випадкової
# втрати в прод, див. AuthService.assertDevLoginEnabled). НІКОЛИ не
# ставити true в проді.
ENABLE_DEV_LOGIN="false"

# Бот сайту/TMA — Login Widget на apps/web + initData bootstrap для apps/tma
TELEGRAM_BOT_TOKEN="123456:bot-token"
# Окремий бот для apps/admin (у Login Widget домен прив'язується через
# @BotFather /setdomain лише до одного домену на бота)
TELEGRAM_ADMIN_BOT_TOKEN="654321:admin-bot-token"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

GROK_API_KEY="xai-..."

# Модель для всіх викликів xAI (синхронних і Batch API).
# ВАЖЛИВО: 15.05.2026 xAI зняла з експлуатації всю "fast"-лінійку
# (grok-4-fast-*, grok-3, grok-4-0709). Запити до знятих слагів МОВЧКИ
# перенаправляються на grok-4.3 і тарифікуються за його цінами — саме
# через це облік витрат у адмінці показував суму приблизно вп'ятеро
# меншу за реальну.
# Актуальні на 08.2026: grok-4.3 ($1.25/$2.50 за 1M) — дефолт,
# grok-4.6 ($2.00/$6.00) — флагман. Для класифікації і витягу полів,
# чим тут і зайнята модель, дорожчий флагман не дає виграшу.
GROK_MODEL="grok-4.3"

# Модель для Batch API окремо: у пачок свій, вужчий перелік дозволених
# моделей (реальний збій в історії проєкту — "Model grok-4-fast is not
# supported for batch processing"), тож прив'язувати її до GROK_MODEL не
# можна. Міняти лише разом із перевіркою, що модель узагалі приймається
# батчами.
GROK_BATCH_MODEL="grok-4.3"

# Зусилля на міркування: none | low | high, або off — щоб узагалі не
# слати параметр. "off" це аварійний вимикач: якщо API колись почне
# відхиляти поле, він знімає проблему зміною змінної, без редеплою.
GROK_REASONING_EFFORT="low"
# За прямим запитом користувача — окремий ключ від звичайного
# GROK_API_KEY, потрібен ЛИШЕ для плашки балансу акаунта у /admin/
# expenses (xAI Management API, management-api.x.ai) — отримати на
# console.x.ai → Settings → Management Keys. Необов'язково — без
# нього плашка просто покаже "Недоступно" з поясненням, решта функцій
# проєкту не зачіпається.
GROK_MANAGEMENT_API_KEY="xai-mgmt-..."
GROK_TEAM_ID="..."
# ОБОВ'ЯЗКОВО. Цим заголовком захищено InternalCronController — зовнішній
# запуск парсера, розсилок і всіх платних викликів (Grok, Нова Пошта, НБУ).
# Генеруй, не придумуй:  openssl rand -hex 24
CRON_SECRET=""
TELEGRAM_MANAGER_CHAT_ID="-100..."

# Nova Poshta — адаптер портирован из SilverFinance/sibionics-ai (див.
# AUDIT-PHASE-2.md), імена змінних узгоджені з ним.
NOVA_POSHTA_API_KEY=""
NOVA_POSHTA_API_URL="https://api.novaposhta.ua/v2.0/json/"
NOVA_POSHTA_CITY_SENDER_REF=""
NOVA_POSHTA_SENDER_REF=""
NOVA_POSHTA_SENDER_ADDRESS_REF=""
NOVA_POSHTA_CONTACT_SENDER_REF=""
NOVA_POSHTA_SENDER_PHONE=""
NOVA_POSHTA_PAYER_TYPE="Recipient"
NOVA_POSHTA_PAYMENT_METHOD="Cash"
NOVA_POSHTA_CARGO_TYPE="Parcel"
NOVA_POSHTA_DEFAULT_WEIGHT_KG="0.5"
NOVA_POSHTA_DEFAULT_VOLUME="0.002"

BLOB_READ_WRITE_TOKEN=""

# Калькулятор проєкту (ТЗ п.31.6). Resend основний, SMTP — фолбек, якщо
# Resend недоступний.
EMAIL_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------- Спільне для web + admin (серверна, без NEXT_PUBLIC) ----------

# Адреса apps/api всередині Docker-мережі (ім'я сервіса, не localhost) —
# ціль rewrite-проксі next.config.mjs для /api/* запитів із браузера
# (same-origin proxy, вирішує проблему cross-domain cookie при Telegram
# Login Widget, див. AUDIT.md). Локально поза Docker — http://localhost:3001.
API_INTERNAL_URL="http://localhost:3001"

# Показує кнопку "Dev-вхід" в AuthGate/шапці — реально спрацює тільки якщо
# бекенд теж налаштований (ENABLE_DEV_LOGIN=true вище). Тримати false в
# будь-якій збірці, що може опинитись доступною не лише локально.
NEXT_PUBLIC_ENABLE_DEV_LOGIN="false"

# ---------- apps/web ----------

# Публічна — використовується для серверних (SSR) читань публічного
# каталогу напряму (без проксі, ці запити не потребують cookie).
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="solarshop_bot"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Адреса admin-панелі (окремий Next.js застосунок, інший порт/домен) —
# лише для кнопки "Dev-вхід (адмінка)" у шапці сайту (Header.tsx), яка
# швидко переносить у адмінку й одразу сама тисне її dev-вхід
# (?autoDevLogin=1, AuthGate.tsx). Кнопка видима лише при
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true, як і звичайний Dev-вхід сайту.
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# ---------- apps/admin ----------

# Окремий бот для адмінки (не той, що на сайті/в TMA) — див. коментар до
# TELEGRAM_ADMIN_BOT_TOKEN вище.
NEXT_PUBLIC_TELEGRAM_ADMIN_BOT_USERNAME="solarshop_admin_bot"

# ---------- apps/tma ----------

# Той самий NEXT_PUBLIC_API_URL, що й у apps/web (окрема змінна не
# потрібна — TMA використовує ідентичне значення)

# Заголовок, з якого береться IP клієнта для лічильників rate limit.
# Аудит 27.08.2026: раніше читався X-Forwarded-For напряму, тож ліміт
# обходився підробкою заголовка — платні ручки (Grok, НП, НБУ, розсилання
# кошторисів) фактично не були захищені. Тепер потрібен заголовок, який
# виставляє САМА платформа й перезаписує клієнтський: у Vercel це
# x-vercel-forwarded-for (дефолт), у Cloudflare — cf-connecting-ip.
# Порожньо = використати адресу сокета (безпечно, але за одним проксі всі
# відвідувачі рахуються як один).
TRUSTED_CLIENT_IP_HEADER="x-vercel-forwarded-for"

# Скільки ВЛАСНИХ проксі стоїть перед застосунком (Express `trust proxy`).
# Впливає лише на req.ip/req.protocol у логах. Rate limit на це НЕ
# спирається — див. коментар у apps/api/src/rate-limit/client-ip.ts.
TRUSTED_PROXY_HOPS="0"
