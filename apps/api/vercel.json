{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm install && npm run db:generate && npm run db:build && node scripts/db-bootstrap.js",
  "installCommand": "echo skip",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "assets/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
