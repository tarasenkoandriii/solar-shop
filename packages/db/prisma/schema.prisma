// ---------- Корзина / заказы ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  sessionId String?
  items     CartItem[]
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  listingId     String?
  quantity      Int      @default(1)
  priceSnapshot Decimal  @db.Decimal(10, 2)
  addedAt       DateTime @default(now())

  @@unique([cartId, productId, listingId])
}

model Order {
  id                     String      @id @default(cuid())
  userId                 String?
  user                   User?       @relation(fields: [userId], references: [id])
  contactName            String
  contactPhone           String
  comment                String?
  status                 OrderStatus @default(NEW)
  subtotalUsd            Decimal     @db.Decimal(10, 2)
  loyaltyDiscountPercent Float       @default(0)
  totalUsd               Decimal     @db.Decimal(10, 2)
  exchangeRateUah        Decimal     @db.Decimal(10, 4)
  totalUah               Decimal     @db.Decimal(12, 2)
  source                 String
  consentGivenAt         DateTime
  invoicePdfUrl          String?

  npCityRef        String?
  npCityName       String? // нужно для InternetDocument/save (RecipientCityName) — адаптер требует текст, не только Ref
  npWarehouseRef   String?
  npWarehouseName  String? // фолбэк для createTtn, если Ref отделения недоступний (порт з SilverFinance-адаптера)
  npRecipientName  String?
  npRecipientPhone String?
  ttnNumber        String?
  ttnRef           String?
  ttnLabelUrl      String?
  ttnStatus        TtnStatus @default(NOT_CREATED)

  items     OrderItem[]
  delegations OrderDelegation[]
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  listingId String?
  quantity  Int
  priceUsd  Decimal @db.Decimal(10, 2)
  // За прямим запитом користувача — "считать заказ комплекта по
  // самому дешевому (внутренняя цена) и по этому второму варианту
  // (публичная цена)... выводить на вкладке profit обе цены".
  // Знімок собівартості САМЕ на момент замовлення (не поточний
  // Product.cachedCostPriceUsd — ціни постачальників змінюються з
  // часом через парсер, для розрахунку прибутку по СТАРОМУ замовленню
  // потрібна ціна ТОДІ, не зараз). Nullable — замовлення, створені ДО
  // цієї фічі, не мають снапшоту заднім числом.
  costPriceUsd Decimal? @db.Decimal(10, 2)
  // За прямим запитом користувача — "делегируем другим поставщикам и
  // генерируем отдельно ТТН для каждого из них". Nullable — якщо
  // NULL, позиція виконується звичайним способом (з нашого складу,
  // єдиний ТТН замовлення). Сама делегація (постачальник + власний
  // ТТН) — окрема модель OrderDelegation нижче, не пряме поле тут,
  // щоб МОЖНА було зберігати ТТН-дані одного разу на ГРУПУ позицій
  // (усі, делеговані ТОМУ САМОМУ постачальнику в межах замовлення), не
  // дублювати ТТН-поля на кожній позиції окремо.
  delegationId String?
  delegation   OrderDelegation? @relation(fields: [delegationId], references: [id])
  review    ProductReview?
}

// За прямим запитом користувача — "делегируем другим поставщикам и
// генерируем отдельно ТТН для каждого из них". Одна группа = один
// постачальник у межах ОДНОГО замовлення — якщо позиції без прибутку
// делеговані ДВОМ РІЗНИМ постачальникам, буде ДВА окремих записи
// (два окремих ТТН). Той самий набір полів, що вже Order.ttnNumber/
// ttnRef/ttnLabelUrl/ttnStatus — тут МНОЖИННИЙ (кілька на одне
// замовлення), там — єдиний (основна відправка з нашого складу).
model OrderDelegation {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id])
  vendorId    String
  vendor      Vendor      @relation(fields: [vendorId], references: [id])
  items       OrderItem[]
  ttnNumber   String?
  ttnRef      String?
  ttnLabelUrl String?
  ttnStatus   TtnStatus   @default(NOT_CREATED)
  createdAt   DateTime    @default(now())
}

// ---------- Статьи ----------

model Article {
  id             String               @id @default(cuid())
  slug           String               @unique
  sourceUrl      String?
  sourceSite     String?
  // Оригінальний текст із RSS, за яким замовлявся переклад.
  //
  // АУДИТ 25.08.2026: стаття створюється в БД ДО подання пачки в Grok
  // Batch API. Якщо подання провалилось (або пачку згодом визнали
  // невдалою), рядок лишався назавжди — наступний прогін знаходив його за
  // sourceUrl і пропускав, тож переклад не замовлявся вже НІКОЛИ. А
  // перескласти запит було нізвідки: у таблиці лишались тільки slug і
  // посилання на джерело, самого тексту не було. Через кілька діб його
  // немає вже і в RSS-стрічці.
  //
  // Тому текст зберігається одразу при створенні. Це не дублювання
  // перекладів (ті лежать в ArticleTranslation): це ВХІДНІ дані, єдине,
  // з чого можна повторити роботу.
  sourceTitle    String?
  sourceExcerpt  String?
  // Коли переклад для статті востаннє замовляли — і скільки разів усього.
  //
  // Без цієї пари повторне замовлення не має гальм: єдине, що прибирає
  // статтю з черги ремонту, — поява перекладу, а він приходить через
  // години (пачки xAI — до доби). Усі прогони парсера в цьому проміжку
  // замовляли б ту саму статтю знову й знову, а стаття, чий рерайт
  // ніколи не розбирається, замовлялась би ВІЧНО. Той самий запобіжник,
  // що вже стоїть на картинках (ProductImage.mirrorAttempts) і на
  // пачках (GrokBatchJob.pollAttempts).
  //
  // Проставляється при ПЕРШОМУ замовленні теж — тому черга ремонту
  // відлічує вік від моменту замовлення, а не створення рядка, і не
  // чіпає статтю, чия пачка ще законно в роботі.
  translationOrderedAt DateTime?
  translationOrders    Int       @default(0)
  originalLocale String               @default("uk")
  coverImage     String?
  // За прямим запитом користувача ("немає фото... також підтягати фото
  // для попередніх статей") — знайдено реальний пробіл: оригінальний
  // URL картинки з RSS раніше НІКОЛИ не зберігався окремо від
  // фінального coverImage (Vercel Blob URL) — якщо перше завантаження
  // на Blob провалилось (напр. BLOB_READ_WRITE_TOKEN ще не був
  // налаштований на момент парсингу), URL картинки-джерела губився
  // НАЗАВЖДИ, backfill без повторного парсингу RSS ставав фізично
  // неможливим. Тепер зберігається завжди, незалежно від результату
  // завантаження на Blob — дозволяє retry пізніше без нового RSS-запиту.
  sourceImageUrl String?
  // За прямим запитом користувача — "добавить скоринг статьи...
  // релевантность теме и интересные факты есть ли в ней". Один
  // агрегований показник (0-100), не два окремих числа — LLM враховує
  // ОБИДВА критерії при формуванні єдиної оцінки (промпт explicitly
  // просить саме так, окремий batch-запит на статтю, не per-locale —
  // GrokService.buildArticleScorePrompt()). Nullable — доки відповідний
  // batch-запит ще не оброблений.
  score          Int?
  scoreReasoning String?
  tags           String[]
  publishedAt    DateTime?
  status         ArticleStatus        @default(DRAFT)
  translations   ArticleTranslation[]
  createdAt      DateTime             @default(now())

  // Черга ремонту перекладів ходить саме по цій парі — без індексу це
  // послідовний скан із корельованим анти-join'ом на кожен прогін.
  @@index([status, translationOrderedAt])
}

model ArticleTranslation {
  id        String        @id @default(cuid())
  articleId String
  article   Article       @relation(fields: [articleId], references: [id])
  locale    String
  slug      String
  title     String
  excerpt   String
  content   String
  status    ArticleStatus @default(DRAFT)
  createdAt DateTime      @default(now())

  @@unique([articleId, locale])
  @@unique([locale, slug])
}

// ---------- Крон-реестр (ТЗ п.27) ----------

model CronJobRun {
  id             String        @id @default(cuid())
