// ---------- Rate limiting (ТЗ п.28.3) ----------

model RateLimitEntry {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([key, windowStart])
  @@index([key])
}

// ---------- Новая почта: локальный кэш справочника (ТЗ п.22.3) ----------

model NovaPoshtaCity {
  ref        String                @id
  name       String
  region     String?
  lat        Float? // для PVGIS-пайплайна (ТЗ п.31.10.2a) — одноразовый геокодинг при заполнении справочника
  lng        Float?
  warehouses NovaPoshtaWarehouse[]
  updatedAt  DateTime              @updatedAt

  @@index([name])
}

model NovaPoshtaWarehouse {
