// ---------- Курс НБУ (ТЗ п.24.2) ----------

// Підготовка до мультикраїнності (див. коментар біля model Country) —
// НБУ-курс (rateUah) залишений з поточною назвою поля свідомо, НЕ
// перейменований на щось загальніше (напр. rateToBase) — це торкнулося
// б купи споживачів (formatPrice, кошик, рахунки-фактури) без
// конкретної потреби зараз. countryCode додано, щоб майбутні курси
// іншої валюти (напр. PLN) могли співіснувати в тій самій таблиці —
// фактичне узагальнення поля rateUah/повна мультивалютна логіка
// лишається окремою, більшою задачею на майбутнє, не зробленою тут.
model ExchangeRate {
  id          String   @id @default(cuid())
  currency    String
  rateUah     Decimal  @db.Decimal(10, 4)
  rateDate    DateTime
  fetchedAt   DateTime @default(now())
  countryCode String   @default("UA")

  @@unique([countryCode, currency, rateDate])
}

// ============================================================
// Фаза 3 — ИИ-калькулятор проекта (ТЗ п.31)
// ============================================================

enum SchemaTopology {
  OFF_GRID
  BACKUP_UPS
  GRID_TIE
  COMMERCIAL
}

enum SchemaDiagramType {
  BLOCK
  PRINCIPAL
}

enum EstimateStatus {
  DRAFT
  FINALIZED
  SENT
  CONVERTED_TO_ORDER
}

// Фаза 4 (ТЗ п.31.11.0) — не реализуется в Фазе 3, поля остаются NOT_REQUESTED/пустыми
enum GenerationStatus {
  NOT_REQUESTED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// Фаза 4 (ТЗ п.31.12) — не реализуется в Фазе 3, поле остаётся NONE/null
enum ScalingStrategy {
  NONE
  HEADROOM
  IDENTICAL_SEGMENTS
}

// Фаза 4 (ТЗ п.31.11.4/31.11.6) — powerRangeTag на BusinessPlanManifest
enum PowerRangeTag {
  SMALL
  MEDIUM
  LARGE
  COMMERCIAL
}

// ТЗ п.31.1.1 — не хардкод, редактируемый справочник (как Tag)
model ProjectGoal {
  id              String          @id @default(cuid())
  key             String          @unique
  label           String
  description     String?
  defaultTopology SchemaTopology?
  generatedBy     String          @default("manual") // 'ai' | 'manual'
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
}

// ТЗ п.31.10.1 — фиксированные вручную подготовленные шаблоны схем,
// НИКОГДА не генерируются ИИ свободно (см. AUDIT — критично для безопасности).
model SchemaTemplate {
  id              String            @id @default(cuid())
  topology        SchemaTopology
  diagramType     SchemaDiagramType
  svgTemplate     String // SVG с именованными плейсхолдерами блоков
  notes           String?
  lastAuditReport String? // текст последнего разового ИИ-аудита, ТЗ п.31.10.1a
  lastAuditAt     DateTime?
  updatedAt       DateTime          @updatedAt

  @@unique([topology, diagramType])
}

// ТЗ п.31.10.2a — кэш выработки энергии по координатам, источник PVGIS
// Підготовка до мультикраїнності — свідомо БЕЗ countryCode тут (на
// відміну від решти моделей у цьому розділі README). Сирі точки PVGIS —
// чисто географічні координати, не політично прив'язані до країни;
// bounding box'и різних країн у практиці не перетинаються (Україна і
// Польща — різні геозони), тому ризику колізії координат немає.
// Countryscoping потрібен саме для BOUNDING BOX (яку ділянку сітки
// рахувати) — це параметр countryBounds у getCountryBounds()
// (solar-map.service.ts), не властивість самої точки.
model SolarYieldEstimate {
  id              String   @id @default(cuid())
  lat             Float
  lng             Float
  tiltDegrees     Int      @default(35)
  azimuthDegrees  Int      @default(0) // 0 = юг (конвенция PVGIS)
  annualKwhPerKwp Decimal  @db.Decimal(10, 2)
  fetchedAt       DateTime @default(now())

  @@unique([lat, lng, tiltDegrees, azimuthDegrees])
}

// ТЗ п.31.10.3 — блочная/принципиальная схема конкретного расчёта
model ProjectEstimateDiagram {
  id                String            @id @default(cuid())
  projectEstimateId String
  projectEstimate   ProjectEstimate   @relation(fields: [projectEstimateId], references: [id])
  diagramType       SchemaDiagramType
  svgUrl            String
  pngUrl            String?
  createdAt         DateTime          @default(now())

  @@unique([projectEstimateId, diagramType])
}

// ---------- Фаза 4 (только схема, без реализации в Фазе 3) ----------
// BusinessPlanManifest/ProjectPhase включены в схему сейчас (не отдельной
// миграцией потом), т.к. ProjectEstimate ссылается на них по FK — тот же
// подход, что и с полями Order под Фазу 2 внутри схемы Фазы 1. Реальная
// генерация бизнес-планов/поэтапного масштабирования — ТЗ явно относит к
// Фазе 4 (п.11), не реализуется здесь.

model BusinessPlanManifest {
  id             String           @id @default(cuid())
  version        Int
  goalTags       String[]
  powerRangeTag  PowerRangeTag?
  content        String
  generatedBy    String
  adminUserId    String?
  changeNote     String?
  isActive       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  projectEstimates ProjectEstimate[]
}

model ProjectPhase {
  id                 String          @id @default(cuid())
  projectEstimateId  String
  projectEstimate    ProjectEstimate @relation(fields: [projectEstimateId], references: [id])
  phaseNumber        Int
  title              String
  description        String
  specItems          Json
  cumulativeTotalUsd Decimal         @db.Decimal(10, 2)
  timingNote         String?
  createdAt          DateTime        @default(now())

  @@unique([projectEstimateId, phaseNumber])
}

// ТЗ п.31.3 — основная модель калькулятора
model ProjectEstimate {
  id                     String            @id @default(cuid())
  userId                 String?
  user                   User?             @relation(fields: [userId], references: [id])
  sessionId              String? // гостевая сессия до логина, тот же паттерн что Cart.sessionId
  name                   String
  city                   String?
  cityRef                String? // Ref города НП — нужен для PVGIS lat/lng, ТЗ п.31.10.2a
  budgetUsd              Decimal?          @db.Decimal(10, 2)
  goals                  String[] // ProjectGoal.key
  dailyConsumptionKwh    Decimal?          @db.Decimal(6, 2)
  // За прямим запитом користувача ("нету вводных в квизе" для кабелю
  // зниження) — метрів від місця встановлення до точки підключення
  // споживача. Зберігається окремо (не всередині recommendedSpec Json)
  // — щоб можна було перерахувати кабель заново без повторного
  // проходження всього квизу, якщо користувач лише уточнить відстань.
  cableRunMeters         Decimal?          @db.Decimal(6, 2)
  financingNeeded        Boolean           @default(false)
  ownFundsPercent        Float?
  // За прямим запитом користувача — "В квиз при ветке нужно
  // кредитование добавить вопрос кого представляет пользователь -
  // физлицо осбб и тд (значения фильтра из вкладки кредитование)".
  // Ті самі текстові значення, що вже FinancingFilters.tsx
  // ("фізичні"/"ОСББ"/"бізнес") — не новий enum, щоб напряму
  // збігатись із фільтром `eligibility` на /financing і з
  // FinancingService.findForBusinessPlan(), яка раніше вгадувала цей
  // тип евристикою по цілях проєкту (розділ README) — тепер реальна
  // відповідь користувача замінює цю здогадку.
  clientType             String?
  // За прямим запитом користувача — "Если доп установка инвертор
  // может быть не нужен - добавить в квиз опциональность инвертора".
  // За замовчуванням false — не впливає на існуючу поведінку. Значення
  // ЗАВЖДИ визначає, чи додається інвертор до спецификації —
  // ДЕТЕРМІНОВАНО в calculator.service.ts, не покладається на те, що
  // Grok "зрозуміє" це з тексту промпту (той самий принцип, що вже
  // CNY-конвертація — критичне бізнес-рішення не довіряється LLM).
  hasExistingInverter    Boolean           @default(false)
  // За прямим запитом користувача — "внести в квиз вопрос - доверять
  // ли рекомендациям" + "учитывать это поле рекомендации опционально
  // при выборе компонентов". Зберігається (не transient) — потрібне і
  // для повторного перегляду вкладки "Обґрунтування" будь-коли
  // пізніше, не лише одразу після start().
  trustRecommendations   Boolean           @default(false)
  // За прямим запитом користувача — "написать обоснование выбора
  // компонентов системы, и учтены ли рекомендации при подборе и
  // какие, соответствие бизнес целям тоже внести". Детермінований
  // текст/структура з resolveRequirementsToCatalog(), НЕ AI-
  // генерація — точний запис РЕАЛЬНОЇ причини вибору кожного
  // компонента надійніший за пост-фактум LLM-пояснення (яке могло б
  // "галюцинувати", що рекомендації враховувались, коли насправді ні).
  selectionReasoning     Json?
  creditAmountUsd        Decimal?          @db.Decimal(10, 2)
  businessPlanUrl        String? // Фаза 4
  businessPlanManifestId String? // Фаза 4
  businessPlanManifest   BusinessPlanManifest? @relation(fields: [businessPlanManifestId], references: [id])
  scalingStrategy        ScalingStrategy?  @default(NONE) // Фаза 4
  phases                 ProjectPhase[] // Фаза 4
  recommendedSpec        Json // [{ productId, articleNumber, quantity, priceUsd }], ТЗ п.31.4
  totalUsd                Decimal          @db.Decimal(10, 2)
  exchangeRateUah         Decimal?         @db.Decimal(10, 4)
  exchangeRateDate        DateTime?
  totalUah                Decimal?         @db.Decimal(12, 2)
  conversationLog         Json // история промптов + ответов Grok
  annotationText          String?
  schemaTopology          SchemaTopology?
  diagrams                ProjectEstimateDiagram[]
  pdfUrl                  String?
  deliveries              ProjectEstimateDelivery[] // куда/когда/статус отправки ПРОМІЖНОГО PDF (export/send, ТЗ п.31.6) — окрема таблиця, множинні спроби
  // Куди відправити ФІНАЛЬНИЙ пакет документів після batch-генерації
  // бізнес-плану (ТЗ п.31.11.0, request-documents) — НЕ те саме, що
  // ProjectEstimateDelivery: тут один цільовий контакт на весь чек-лист,
  // а не історія кількох спроб відправки. Знайдено при аудиті реальної
  // Docker-збірки: ці два поля були прибрані з ProjectEstimate під час
  // аудиту фічі відправки (Фаза 3), коли contactChannel/contactValue
  // винесли в ProjectEstimateDelivery — але пізніше, при реалізації
  // request-documents (Фаза 4), код почав знову писати/читати їх напряму
  // на ProjectEstimate, а схему забули повернути. Пісочниця без
  // згенерованого Prisma Client цю помилку не ловила — виявлено тільки на
  // реальній Docker-збірці.
  contactChannel          String?
  contactValue            String?
  requestedDocuments      String[] // Фаза 4
  generationStatus        GenerationStatus @default(NOT_REQUESTED) // Фаза 4
  status                  EstimateStatus   @default(DRAFT)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([userId])
  @@index([sessionId])
}

enum DeliveryChannel {
  TELEGRAM
  EMAIL
  WHATSAPP
  VIBER
}

enum DeliveryStatus {
  PENDING // запис створено, відправка ще не спробувана/в процесі
  SENT    // для TELEGRAM/EMAIL — підтверджений виклик API; для WHATSAPP/VIBER — діплінк згенеровано і відданий користувачу (див. AUDIT — це не підтверджена доставка)
  FAILED
}

// Куда/когда/статус отправки материалов проекта — отдельная таблица (не
// поля на ProjectEstimate), т.к. один проект может отправляться повторно и
// на разные каналы, история должна сохраняться, не перезаписываться.
model ProjectEstimateDelivery {
  id                String          @id @default(cuid())
  projectEstimateId String
  projectEstimate   ProjectEstimate @relation(fields: [projectEstimateId], references: [id])
  channel           DeliveryChannel
  contactValue      String // email/телефон/telegramId в залежності від каналу
  status            DeliveryStatus  @default(PENDING)
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())

  @@index([projectEstimateId])
  @@index([status])
}

// За прямим запитом користувача — "тарифицировать приблизительно в
// токенах и деньгах расходы, показать и привязывать к telegram id".
// Свідомо scope обмежено ітеративним квизом створення проєкту
// (extractCalculatorRequirements у start()/refine() +
// generateProjectAnnotation при фіналізації) — саме та "ітеративна
// схема спілкування", про яку прямо йшлося в запиті, не ВСІ
// AI-виклики проєкту (парсер статей/фінансових програм — окрема,
// значно ширша задача, свідомо НЕ зроблена тут).
//
// userId nullable — гостьова сесія до логіну (той самий патерн, що
// Cart.sessionId/ProjectEstimate.sessionId) теж має вартість, навіть
// якщо ще не прив'язана до конкретного telegramId — sessionId
// зберігається окремо, щоб не губити ці дані, коли гість пізніше
// логіниться.
model GrokUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  sessionId        String?
  projectEstimateId String? // якщо відомий на момент виклику (refine — так, start — ще ні, там estimate щойно створюється)
  purpose          String // 'calculator_requirements' | 'calculator_annotation'
  model            String // напр. 'grok-4-fast' — щоб цінник рахувався за ФАКТИЧНОЮ моделлю виклику, не жорстко захардкодженою
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostUsd Decimal  @db.Decimal(10, 6) // 6 знаків — суми часто менші за $0.01 за один виклик
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// За прямим запитом користувача — "административные расходы" (окрема
// секція вкладки "Витрати" в адмінці) — ручний облік бізнес-витрат, НЕ
// пов'язаних з AI (хостинг, домен, реклама тощо). Простий CRUD, без
// прив'язки до конкретного постачальника/категорії суворою типізацією
// (category — вільний рядок, не enum) — щоб адмін міг вписати будь-що,
// не чекаючи розширення схеми під кожну нову статтю витрат.
model AdminExpense {
  id          String   @id @default(cuid())
  description String
  category    String? // напр. 'hosting' | 'domain' | 'реклама' — вільний рядок
  amountUsd   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// Фаза 4 — бизнес-план, финансирование, продвинутый маркетинг (ТЗ п.31.11,
// 31.12, 32, 34.2-34.6). BusinessPlanManifest/ScalingStrategy/ProjectPhase
// уже были заведены в схему на этапе Фазы 3 (форвард-совместимость FK на
// ProjectEstimate) — здесь только реализация их функциональности плюс
// остальные модели.
// ============================================================

// ТЗ п.31.11.1a — тариф для розрахунку окупності (зелений тариф / роздрібна
// економія на самоспоживанні), ведеться вручну в адмінці, не парситься.
model TariffRate {
  id             String   @id @default(cuid())
  key            String // 'GREEN_TARIFF' | 'RETAIL_AVERAGE'
  label          String
  rateUahPerKwh  Decimal  @db.Decimal(6, 4)
  sourceUrl      String?
  updatedAt      DateTime @updatedAt
  // Підготовка до мультикраїнності (див. коментар біля model Country) —
  // тарифи на електроенергію завжди національні/регіональні. Дефолт
  // "UA" + перенесення унікальності з одного лише `key` на пару
  // (countryCode, key) — щоб майбутня країна могла мати свій
  // GREEN_TARIFF/RETAIL_AVERAGE без конфлікту з українськими значеннями.
  countryCode    String   @default("UA")

  @@unique([countryCode, key])
}

// За прямим запитом користувача — "На вкладке Налаштування добавить
// секцію Налаштування документообігу, тот же список что в четвертой
// вкладке калькулятора". Простий toggle на кожен тип документа з
// DocumentChecklist.tsx (SPEC/ANNOTATION/BLOCK_DIAGRAM/
// PRINCIPAL_DIAGRAM/BUSINESS_PLAN) — чи можна клієнту його обрати на
// сайті. SPEC і BUSINESS_PLAN захищені від вимкнення на backend-рівні
// (не лише UI, розділ CalculatorSettingsService) — "Спецификация и
// бизнес план чекбоксами всегда ✅ checked".
model DocumentTypeSetting {
  id      String  @id @default(cuid())
  key     String  @unique // 'SPEC' | 'ANNOTATION' | 'BLOCK_DIAGRAM' | 'PRINCIPAL_DIAGRAM' | 'BUSINESS_PLAN'
  enabled Boolean @default(true)
}

// ТЗ п.31.11.6 — границі діапазонів потужності (SMALL/MEDIUM/LARGE),
// оцінюються через ІІ по статистиці каталогу, застосовуються вручну.
model PowerRangeThreshold {
  id              String        @id @default(cuid())
  tag             PowerRangeTag @unique
  minPanelsWattW  Int // нижня межа сумарної потужності панелей проєкту, Вт
  maxPanelsWattW  Int? // null = без верхньої межі (COMMERCIAL)
  aiSuggestion    String? // текст останньої пропозиції ІІ з обґрунтуванням, чернетка до застосування
  updatedAt       DateTime      @updatedAt
}

// ТЗ п.31.12.6 — поріг «незначної переплати» для стратегії HEADROOM,
// оцінюється через ІІ по реальних цінових кроках каталогу.
model ScalingThreshold {
  id                      String          @id @default(cuid())
  category                String
  headroomMaxPricePercent Float
  aiSuggestion            String?
  updatedAt               DateTime        @updatedAt

  @@unique([category])
}

enum FinancingProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ТЗ п.31.11.2/32 — реальні програми кредитування, ІІ лише знаходить
// кандидатів (ІІ-парсер, п.32.1), не публікує сам — обов'язкова модерація.
model FinancingProgram {
  id                 String                  @id @default(cuid())
  name               String
  eligibility        String // "фізичні особи" / "ОСББ/ЖБК" / "бізнес"
  description        String
  url                String
  discoverySourceUrl String?
  minLoanUsd         Decimal?                @db.Decimal(10, 2)
  maxLoanUsd         Decimal?                @db.Decimal(10, 2)
  // За запитом користувача — "парсити і картинки з сайтів програм
  // кредитування" + "верифікувати чи є картинки в попередніх оголошеннях
  // і дописувати". Nullable — старі записи (до цього поля) підтягнуть
  // картинку природним чином при наступному повторному парсингу того ж
  // seed-topic (той самий цикл, що вже шукає ці програми регулярно,
  // окремий backfill-прохід не потрібен).
  imageUrl           String?
  status             FinancingProgramStatus  @default(PUBLISHED)
  lastVerifiedAt     DateTime?
  lastSeenInParserAt DateTime? // ТЗ п.32.1 крок 5 — коли востаннє зустрічалась при парсингу
  needsRecheck       Boolean                 @default(false) // не зустрічалась останні N прогонів — можливо закрилась
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  // Підготовка до мультикраїнності (див. коментар біля model Country) —
  // програми кредитування завжди прив'язані до конкретної країни
  // (банк/уряд), дефолт "UA" зберігає коректність наявних записів.
  countryCode        String                  @default("UA")
  reviews            FinancingProgramReview[]

  @@index([status])
  @@unique([name, url])
}

enum ReviewTextStatus {
  PENDING
  APPROVED
  REJECTED
}

// За прямим запитом користувача — комплексний відгук про програму
// кредитування, 4 шкали + опційний текст. Числові оцінки публікуються
// одразу (агрегати на картках рахуються по них негайно), текст —
// окремо модерується в адмінці, до затвердження ніде публічно не
// показується. Прив'язка до User (Telegram) — лише для анти-спаму (один
// відгук на програму від користувача) і НІКОЛИ не віддається публічно —
// жодного публічного API-поля з іменем/юзернеймом клієнта немає
// взагалі, статистика анонімна за задумом (дисклеймер на сторінці
// відгуків), не просто "приховане поле".
model FinancingProgramReview {
  id                  String           @id @default(cuid())
  financingProgramId  String
  financingProgram    FinancingProgram @relation(fields: [financingProgramId], references: [id])
  userId              String
  user                User             @relation(fields: [userId], references: [id])
  city                String
  branch              String
  // 1-5 кожна. businessPlanQualityScore — "скільки довелось доробляти"
  // (5 = нічого не довелось доробляти, план був готовий одразу).
  businessPlanQualityScore Int
  bankResponsivenessScore  Int
  processingSpeedScore     Int
  applicationSuccessScore  Int
  // Окреме число (не просто якісна шкала) — "процент покриття заявки
  // від прогнозу" калькулятора, наскільки реально схвалена сума
  // збіглась із розрахованою. Nullable — клієнт міг не знати точний %.
  coveragePercent     Int?
  reviewText          String?
  reviewTextStatus    ReviewTextStatus @default(PENDING)
  createdAt           DateTime         @default(now())

  @@unique([financingProgramId, userId])
  @@index([financingProgramId])
}

// ТЗ п.34.6.4 — простий лог показів embed-віджету карти потенціалу
model EmbedView {
  id          String   @id @default(cuid())
  widgetKey   String // 'solar-map' — на майбутнє, якщо з'являться інші віджети
  refererHost String?
  viewedAt    DateTime @default(now())

  @@index([widgetKey, viewedAt])
}

// Кэш IDW-интерполированной сетки карты потенциала (аудит Фазы 4 —
// см. AUDIT-PHASE-4.md/AUDIT-FULL.md): интерполяция считается один раз при
// пересчёте офлайн-сетки (тяжёлая операция), не на каждый запрос страницы.
// Одна строка на резолюцию сетки — climatology почти не меняется, кэш без
// срока годности, пересчитывается вручную вместе с офлайн-сеткой PVGIS.
model SolarMapInterpolatedGrid {
  id          String   @id @default(cuid())
  resolution  Int      // количество ячеек по большей стороне bounding box
  cellsJson   Json     // [{ lat, lng, annualKwhPerKwp }] — плотная интерполированная сетка
  sourcePoints Int     // сколько исходных точек PVGIS использовано для интерполяции — для отладки/прозрачности
  computedAt  DateTime @default(now())
  // Підготовка до мультикраїнності (див. коментар біля model Country) —
  // bounding box для інтерполяції завжди прив'язаний до конкретної
  // країни (UKRAINE_BOUNDS у solar-map.service.ts). Дефолт "UA" +
  // перенесення унікальності з одного лише `resolution` на пару
  // (countryCode, resolution) — інакше сітка Польщі перезаписала б
  // українську при тій самій роздільній здатності.
  countryCode String   @default("UA")

  @@unique([countryCode, resolution])
}

// Асинхронна пачка запитів до xAI Batch API — за прямим запитом користувача
// ("используй grok batch job с ожиданием для экономии средств"), паттерн і
// точна форма ендпоінтів перенесені з реально протестованого коду проєкту
// RoadScout (doc/AUDIT-grok-batch-api.md там) — Batch API коштує на 20-50%
// дешевше за звичайні синхронні виклики (docs.x.ai/developers/pricing),
// але обробка асинхронна (типово до 24 годин, best-effort, не гарантовано)
// — не підходить для інтерактивних сценаріїв (калькулятор, дев-логін), але
// ідеально для фонового рерайту/перекладу статей (ТЗ п.17.2), де користувач
// і так не чекає результат синхронно.
model GrokBatchJob {
  id          String    @id @default(cuid())
  xaiBatchId  String    @unique
  // Тип роботи в цій пачці — наразі тільки 'article-rewrite', але поле
  // навмисно рядкове (не enum), щоб додавати нові типи пачок без міграції.
  jobType     String
  // pending (щойно подано) -> processing (частково готово, чекаємо решту)
  // -> completed (результати забрані й оброблені) -> failed
  status      String    @default("pending")
  // Мапа "batch_request_id -> контекст запиту" (для article-rewrite:
  // {articleId, locale}) — потрібна, щоб зіставити результати назад із
  // конкретною статтею/локаллю після отримання відповіді від xAI.
  requestMap  Json
  // Скільки разів джоб опитування вже брався за цю пачку і не зміг її
  // завершити. АУДИТ 25.08.2026: без цього лічильника пачка, у якій усі
  // запити впали (або яку xAI віддає без поля state), поверталась у
  // чергу опитування ВІЧНО — статус 'failed' описаний у коментарі вище,
  // але не виставлявся ніде в коді. Кожен прогін крона витрачав на неї
  // запит статусу плюс до 50 сторінок результатів, і таких пачок з часом
  // ставало більше.
  pollAttempts Int      @default(0)
  // Чому пачку визнано невдалою — щоб у адмінці було видно різницю між
  // "xAI не змогла" і "ми не змогли розібрати відповідь".
  failureReason String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
}

// ============================================================
// Мультикраїнність — за прямим запитом користувача: "заложи в
// архитектуре (особенно бд) сразу что возможно масштабирование на
// другие страны например Польшу (пока без конкретики по странам)".
// Довідкова таблиця + countryCode на регіонально-залежних моделях
// нижче — без жодної Польщо-специфічної логіки зараз, лише точка
// розширення, щоб додавання нової країни пізніше не вимагало болючих
// міграцій (перейменування таблиць, зміни унікальних ключів на вже
// заповнених даними моделях).
// ============================================================

model Country {
  code         String  @id // ISO 3166-1 alpha-2 ('UA', майбутнє 'PL' тощо)
  name         String
  currencyCode String  // ISO 4217 ('UAH', майбутнє 'PLN')
  isActive     Boolean @default(true)
}
