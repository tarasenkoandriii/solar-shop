// Solar Shop — Фаза 2 (парсер + коммерция)
// Расширяет схему Фазы 1 согласно ТЗ п.11 «Фаза 2»: Vendor/SourceListing/
// ProductListing (siblings), Cart/Order/OrderItem, Article/ArticleTranslation,
// PromoSettings, LoyaltyTier, CronJobRun, RateLimitEntry.
//
// ВАЖНАЯ МИГРАЦИЯ МОДЕЛИ Product: в Фазе 1 у Product были свои priceUsd/
// images/inStock/isNew — с приходом siblings (п.13) источник истины по цене/
// наличию/фото переезжает на SourceListing/ProductImage (см. устаревшую
// пометку в самом ТЗ п.4 и актуальную схему п.13.1). Прямых полей цены на
// Product больше нет — эффективная цена вычисляется как MIN(priceUsd) среди
// listings с inStock=true (ТЗ п.13.3), это ответственность API-слоя, не БД.
//
// Lead из Фазы 1 остаётся ТОЛЬКО для общей формы обратной связи на /contacts
// (ТЗ п.3.4) — сценарий "узнать цену"/"купить" на карточке товара теперь
// полностью проходит через Cart/Order (ТЗ п.19), не через Lead.

generator client {
  provider = "prisma-client-js"
  // Знайдено на реальному Docker-деплої (18.08.2026): без явного
  // binaryTargets Prisma намагається автовизначити OpenSSL на етапі
  // generate — у контейнері `node:20-alpine` це визначення провалилось
  // ("Prisma failed to detect the libssl/openssl version... Defaulting to
  // openssl-1.1.x") і скачало ДВИГУН під OpenSSL 1.1.x, а рантайм-образ
  // (той самий node:20-alpine, Alpine 3.19+) реально має OpenSSL 3.x —
  // "Error loading shared library libssl.so.1.1: No such file or
  // directory". "native" — для генерації на хості під час розробки
  // (macOS/Linux напряму), "linux-musl-openssl-3.0.x"/"linux-musl-arm64-
  // openssl-3.0.x" — Alpine-контейнери цього проєкту під amd64/arm64
  // відповідно (Mac з Apple Silicon за замовчуванням білдить arm64-образи
  // в Docker Desktop — без arm64-варіанту рушій знову не знайшовся б).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

// За прямим запитом користувача — "для supabase должен быть
// DIRECT_URL для конфига ORM". Supabase дає ДВА різних підключення:
// пул через PgBouncer (порт 6543, transaction mode) для рантайм-
// запитів застосунку, і пряме підключення (порт 5432) для міграцій —
// PgBouncer у transaction mode НЕ підтримує prepared statements, які
// Prisma використовує під час `migrate`/`db push`, тому без
// directUrl міграції з пулера просто впадуть з помилкою. DATABASE_URL
// лишається для локальної розробки (docker-compose Postgres, розділ
// README) — там немає пулера, обидва значення природно однакові.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Общие enum'ы ----------

