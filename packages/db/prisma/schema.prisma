enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============================================================
// Категорії товарів — за прямим запитом користувача: раніше жорсткий
// Postgres-enum ProductCategory (SOLAR_PANEL/BATTERY/CONTROLLER), тепер
// таблиця, щоб нові категорії могли з'являтись через модерацію в
// адмінці без деплою коду/міграції схеми (додавання значення в
// Postgres-enum вимагало б саме цього). `Product.category`/
// `ArticleNumberSequence.category`/`PromoSettings.category`/
// `ScalingThreshold.category` тепер прості String-поля, що
// (М'ЯКО, без жорсткого FK-constraint — той самий патерн, що вже
// застосований для Vendor.name-посилань деінде в проєкті) відповідають
// Category.key. 3 існуючі категорії засіяні (seed.ts) зі статусом
// APPROVED — увесь наявний код, що порівнює product.category === 
// 'SOLAR_PANEL' тощо, лишається коректним без жодних змін, бо значення
// рядків не змінились, змінився лише СПОСІБ їх зберігання (String
// замість enum-constraint).
// ============================================================

enum CategoryStatus {
  PENDING // сирий rawCategory/siteCategoryLabel не відповідає жодній відомій категорії — очікує рішення адміна
  APPROVED
  REJECTED
}

model Category {
  id                  String         @id @default(cuid())
  key                 String         @unique // 'SOLAR_PANEL' / 'BATTERY' / 'CONTROLLER' / новий слаг для щойно виявленої категорії
  nameUk              String
  nameRu              String
  nameEn              String
  // Префікс артикулу ('SP'/'BAT'/'CTRL') — раніше жорстко закодований
  // Record<ProductCategory,string> у products.service.ts, тепер тут,
  // щоб нова категорія могла отримати свій префікс без зміни коду.
  articleNumberPrefix String
  status              CategoryStatus @default(APPROVED)
  createdAt           DateTime       @default(now())

  @@index([status])
}

enum VendorContractStatus {
  NOT_CONTACTED
  NEGOTIATING
  SIGNED
  DECLINED
}

enum MatchType {
  SKU_EXACT
  GTIN_EAN
  FUZZY_NAME
  GROK_LLM
  MANUAL
}

enum OrderStatus {
  NEW
  INVOICED
  PAID
  SHIPPED
  CANCELLED
}

enum TtnStatus {
  NOT_CREATED
  RESERVED
  READY_TO_SHIP
  SHIPPED
  CANCELLED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CronRunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

// ---------- Производитель / товар / галерея / теги ----------

model Manufacturer {
  id        String             @id @default(cuid())
  name      String
  region    ManufacturerRegion
  logoUrl   String?
  country   String
  products  Product[]
  createdAt DateTime           @default(now())
}

model Product {
  id               String          @id @default(cuid())
  slug             String          @unique
  articleNumber    String          @unique
  manufacturerSku  String?
  category         String
  name             String
  manufacturerId   String?
  manufacturer     Manufacturer?   @relation(fields: [manufacturerId], references: [id])
  shortDescription String
  description      String
  specs            Json
  status           ProductStatus   @default(PUBLISHED)
  images           ProductImage[]
  tags             ProductTag[]
  listings         ProductListing[]
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Денормализованный кэш "лучшего" листинга — пересчитывается в
  // ProductPricingService при любом изменении, влияющем на цену/наличие
  // (парсер обновил SourceListing, siblings связаны/отвязаны, promo recalc).
  // Каталог (список/сортировка/фильтр по цене) читает эти поля напрямую,
  // без джойна на SourceListing на каждый запрос — критично для Vercel
  // Hobby serverless-таймаутов при росте каталога за пределы seed-объёма.
  // За прямим запитом користувача — "показывать цену товара по
  // второму из самых дешёвых вариантов, и считать заказ комплекта по
  // самому дешевому (внутренняя цена) и по этому второму варианту
  // (публичная цена)". cachedPriceUsd ЛИШАЄТЬСЯ семантично тим самим
  // "що бачить покупець" (жодних змін у фронтенд-компонентах, які вже
  // читають це поле) — просто ТЕПЕР обчислюється як другий за
  // дешевизною, не найдешевший. Новий cachedCostPriceUsd — внутрішня
  // собівартість (найдешевший listing), НІКОЛИ не показується
  // публічно, лише на вкладці "Прибуток" в адмінці.
  cachedCostPriceUsd   Decimal? @db.Decimal(10, 2) // MIN(priceUsd) — внутрішня собівартість, для розрахунку прибутку
  cachedPriceUsd       Decimal? @db.Decimal(10, 2) // 2-й за дешевизною серед listings з inStock=true — те, що бачить покупець
  cachedInStock        Boolean  @default(false)
  cachedIsPromo        Boolean  @default(false)
  cachedDiscountPercent Float?
  cachedWarehouseCities String[] // объединение Vendor.warehouseCities по listings inStock=true, ТЗ п.25.3
  cachedIsNew          Boolean  @default(false) // вручную в админке (парсер не определяет "новинку" сам)
  pricingUpdatedAt     DateTime?

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    ProductReview[]
  importedReviews ImportedProductReview[]
  importScoutResults ImportScoutResult[]

  @@index([category])
  @@index([manufacturerId])
  @@index([cachedPriceUsd])
  @@unique([manufacturerId, manufacturerSku])
}

// За прямим запитом користувача — "привязать отзывы к покупке - один
// отзыв на каждую позицию в составе проекта, при оставлении отзыва
// фиксировать количество купленных единиц и сколько прошло времени
// от покупки". Замінено попередню прив'язку `@@unique([productId,
// userId])` на прив'язку до КОНКРЕТНОЇ позиції замовлення
// (`orderItemId @unique`) — якщо покупець замовляв той самий товар у
// ДВОХ окремих замовленнях, тепер може лишити ДВА окремих відгуки
// (досвід міг відрізнятись), не один "загальний" на товар.
model ProductReview {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  orderItemId       String           @unique
  orderItem         OrderItem        @relation(fields: [orderItemId], references: [id])
  // Знімки на момент відгуку — НЕ живий join на OrderItem/Order щоразу
  // при показі. quantityAtReview: OrderItem.quantity теоретично не
  // мінявся б після створення, але явний знімок надійніший і не
  // залежить від майбутніх змін моделі. daysSincePurchaseAtReview —
  // ЗБЕРІГАЄТЬСЯ (не рахується наживо при кожному перегляді, щоб не
  // "плаваюче" число день у день без дії користувача), але
  // ПЕРЕРАХОВУЄТЬСЯ явно при редагуванні відгуку (за прямим запитом
  // користувача — "допускается редактировать (пересчитывать сколько
  // прошло от покупки)").
  quantityAtReview          Int
  daysSincePurchaseAtReview Int
  reliabilityScore  Int // 1-10, "сонечка" — той самий UI-патерн SunRating
  reviewText        String?
  reviewTextStatus  ReviewTextStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([productId])
  @@index([userId])
}

// За прямим запитом користувача — "добавить парсер отзывов на товары
// отдельно скриптом для каждого магазина, показать отзывы на нашем
// сайте с указанием источника отзыва". ОКРЕМА модель від
// `ProductReview` (verified purchase від НАШИХ покупців) — структура
// принципово інша: немає orderItemId/quantityAtReview (сайт-джерело
// сам вирішує, як показує кількість/дату), є vendorName+sourceUrl
// (обов'язкове відображення джерела — довіра до "спарсеного" відгуку
// нижча за верифіковану покупку, приховувати це було б нечесно).
// НІКОЛИ не змішується з ProductReview у `pickWithReliability()`
// калькулятора (розділ README про верифіковані покупки) — джерело без
// антиспам/verified-purchase перевірки не заслуговує того самого
// рівня довіри для рекомендацій підбору компонентів.
model ImportedProductReview {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  vendorName       String // Vendor.name джерела — для відображення "Джерело: {vendorName}"
  sourceUrl        String // пряме посилання на сторінку товару, де знайдено відгук
  authorName       String? // як показано на сайті джерела (не наш User — анонімний гість сайту-джерела)
  ratingRaw        Float? // сира оцінка, як на сайті джерела (напр. 1-5)
  ratingNormalized Int? // нормалізовано до тієї самої 1-10 шкали, що ProductReview — для консистентного відображення поряд
  reviewText       String
  publishedAtRaw   String? // дата як текстовий рядок на сайті джерела (не завжди парситься в DateTime однозначно)
  publishedAt      DateTime?
  // Дедуплікація МІЖ повторними прогонами парсера — сайти джерела
  // зазвичай НЕ дають стабільний externalId відгуку в HTML, тому
  // природний ключ — хеш нормалізованого тексту+автора (не
  // sourceUrl+createdAt, які НЕ ідентифікують конкретний відгук
  // однозначно).
  contentHash      String
  scrapedAt        DateTime @default(now())

  @@unique([productId, vendorName, contentHash])
  @@index([productId])
}

// За прямим запитом користувача — реалізація doc/TZ_ImportScout.md.
// Той самий принцип, що вже ImportedProductReview — окрема модель,
// не змішується з жодною наявною ціновою логікою (Product.
// cachedCostPriceUsd лишається джерелом істини для НАШОГО каталогу,
// ця модель — лише знайдені зовнішні пропозиції для порівняння).
model ImportScoutResult {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  // ТЗ розділ 4 (після аудиту) — валідується на DTO-рівні через
  // @IsIn, той самий патерн, що вже StartCalculatorDto.clientType.
  source            String   // "ALIEXPRESS" | "ALIBABA" | "1688"
  title             String   // назва, як знайдено (перекладена, якщо джерело — 1688)
  // ТЗ розділ 2.4/4 — 1688 дає ціни в юанях, оригінал зберігається
  // ОКРЕМО від конвертованого значення (конвертація — детермінований
  // крок бекенду через CurrencyService, не LLM).
  priceRawCny       Decimal? @db.Decimal(10, 2)
  priceMinUsd       Decimal? @db.Decimal(10, 2)
  priceMaxUsd       Decimal? @db.Decimal(10, 2)
  moq               Int?
  sourceUrl         String
  // ТЗ розділ 4/5 — чи відповідає посилання очікуваному патерну
  // сторінки КОНКРЕТНОГО товару (regex перевірка, окремий патерн на
  // кожне джерело), не сторінки категорії/пошуку.
  urlVerified       Boolean  @default(false)
  supplierName      String?
  supplierYearsOnPlatform Int?
  // Знімок НАШОЇ поточної собівартості на момент пошуку (розділ 104
  // README) — для порівняння пізніше, коли наша собівартість вже
  // зміниться.
  ourCostPriceUsdSnapshot Decimal? @db.Decimal(10, 2)
  foundAt           DateTime @default(now())
  requestedBy       String?

  @@index([productId])
}

model ProductImage {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  // Актуальне посилання на картинку. Спочатку — пряме посилання на сайт
  // постачальника (щоб фото було видно ОДРАЗУ після парсингу), після
  // успішного дзеркалювання — посилання на Vercel Blob.
  url             String
  // Оригінальний URL на сайті постачальника — зберігається ЗАВЖДИ, навіть
  // після переїзду на Blob. Той самий принцип, що вже застосований для
  // Article.sourceImageUrl: без нього невдале завантаження неможливо було б
  // повторити, і картинка лишалась би на хотлінку назавжди. Плюс це ключ
  // дедуплікації — один і той самий файл у різних товарів вантажиться раз.
  sourceUrl       String?
  // Проставляється, коли url реально вказує на Blob. null = ще на хотлінку.
  mirroredAt      DateTime?
  // Лічильник невдалих спроб. Картинка, якої вже немає в постачальника,
  // інакше довбалася б щопрогону вічно; після ліміту просто лишається на
  // прямому посиланні й більше не береться в роботу.
  mirrorAttempts  Int      @default(0)
  altText         String?
  sortOrder       Int      @default(0)
  sourceListingId String?
  createdAt       DateTime @default(now())

  @@index([productId])
  // Черга дзеркалювання: беремо рядки з mirroredAt = null.
  @@index([mirroredAt])
  // Пошук уже завантаженого дубліката за оригінальним URL.
  @@index([sourceUrl])
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
}

model ArticleNumberSequence {
  category String @id
  lastSeq  Int             @default(0)
}

// ---------- Парсер: поставщики / сырые листинги / siblings ----------

model Vendor {
  id                String               @id @default(cuid())
  name              String               @unique
  website           String
  warehouseCities   String[]
  isActive          Boolean              @default(true)
  contactPhone      String?
  contactAddress    String?
  contactPersonName String?
  contractStatus    VendorContractStatus @default(NOT_CONTACTED)
  contractSignedAt  DateTime?
  contractNote      String?
  listings          SourceListing[]
  orderDelegations  OrderDelegation[]
  createdAt         DateTime             @default(now())
  // За запитом користувача — підготовка до мультикраїнності. Дефолт "UA"
  // — усі наявні записи лишаються коректними без ручної міграції даних.
  countryCode       String               @default("UA")
  // За запитом користувача — тайм-боксований ідемпотентний крон
  // product_parser (той самий принцип, що pvgis_country_grid): обробка
  // по одному вендору за раз, сортування по lastFullyParsedAt ASC —
  // найдавніше оброблений (або ще ніколи не оброблений — null першим)
  // йде першим. Природна ідемпотентна резюмовність без окремого
  // checkpoint-поля — сам timestamp і є прогресом.
  lastFullyParsedAt DateTime?

  // За запитом користувача — логічніше вважати seed-дані ще одним
  // "постачальником" (той самий SourceListing/ProductListing механізм, що
  // й для реального парсера), а не окремим прапорцем на Product. Але
  // seed-товари НЕ повинні брати участь у siblings-матчингу (ні як
  // "непов'язаний листинг, що потребує модерації", ні як джерело
  // конкуренції з реальними вендорами за той самий товар) — цей прапорець
  // фільтрує такого вендора з SiblingsService.getCandidates().
  excludeFromMatching Boolean            @default(false)
}

model SourceListing {
  id              String              @id @default(cuid())
  vendorId        String
  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  sourceUrl       String
  sourceSku       String?
  rawTitle        String
  rawCategory     String?
  // За прямим запитом користувача ("сохранять сырые категории с сайтов и
  // матчить с существующими") — сирий текст категорії, як він реально
  // відображається на сайті постачальника (H1/breadcrumb сторінки
  // категорії, розділ README) — ОКРЕМО від rawCategory вище (той —
  // внутрішній ключ, який МИ шукаємо на сайті, не те, що сайт сам
  // показує). Використовується для fuzzy-порівняння з Category.name*
  // при матчингу — розбіжність тут сигналізує "можливо, це інша
  // категорія" і йде на модерацію.
  siteCategoryLabel String?
  rawPrice        Decimal             @db.Decimal(12, 2)
  rawCurrency     String              @default("UAH")
  priceUsd        Decimal             @db.Decimal(10, 2)
  priceRateDate   DateTime?
  priceCheckedAt  DateTime            @default(now())
  priceChangedAt  DateTime?
  inStock         Boolean             @default(true)
  stockCheckedAt  DateTime            @default(now())
  stockChangedAt  DateTime?
  images          String[]
  affiliateUrl    String?
  isPromo         Boolean             @default(false)
  discountPercent Float?
  firstSeenAt     DateTime            @default(now())
  lastParsedAt    DateTime            @default(now())
  history         PriceHistoryEntry[]
  products        ProductListing[]

  @@unique([vendorId, sourceUrl])
  @@index([inStock])
}

model PriceHistoryEntry {
  id              String        @id @default(cuid())
  sourceListingId String
  sourceListing   SourceListing @relation(fields: [sourceListingId], references: [id])
  priceUsd        Decimal       @db.Decimal(10, 2)
  inStock         Boolean
  recordedAt      DateTime      @default(now())

  @@index([sourceListingId])
}

model ProductListing {
  id              String        @id @default(cuid())
  productId       String
  sourceListingId String
  product         Product       @relation(fields: [productId], references: [id])
  sourceListing   SourceListing @relation(fields: [sourceListingId], references: [id])
  matchType       MatchType     @default(MANUAL)
  matchConfidence Float?
  isPrimary       Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@unique([productId, sourceListingId])
}

model PromoSettings {
  id               String           @id @default(cuid())
  category         String?
  thresholdPercent Float
  updatedAt        DateTime         @updatedAt

  @@unique([category])
}

// Явное "это разные товары" из очереди модерации siblings (ТЗ п.13.2, шаг 4)
// — чтобы matching engine не предлагал ту же пару повторно на следующем
// прогоне парсера. Кандидаты с confidence в серой зоне (0.5-0.85) сами не
// хранятся отдельной таблицей — вычисляются на лету при открытии вкладки
// «Кандидаты в siblings» (см. AUDIT.md, ограничение производительности при
// росте каталога на порядок).
model RejectedMatch {
  id              String   @id @default(cuid())
  sourceListingId String
  productId       String
  rejectedAt      DateTime @default(now())

  @@unique([sourceListingId, productId])
}

