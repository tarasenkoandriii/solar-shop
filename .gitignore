# Знайдено при зведенні .env-файлів в один кореневий — без .gitignore
# кореневий /.env (з реальними секретами) потрапив би в git при першому ж
# коміті. .gitignore був відсутній у проєкті взагалі (жодного файлу на
# будь-якому рівні), не тільки для .env — додано для всього стандартного
# набору одразу.

# Секрети — НІКОЛИ не комітити
.env
.env.local
.env.*.local
apps/*/.env
apps/*/.env.local

# Залежності
node_modules/

# Next.js build output
.next/
out/

# NestJS build output
apps/api/dist/

# За прямим запитом користувача (реальна помилка деплою Vercel —
# "The path api/index.js has conflicts with api/index.ts") —
# apps/api/api/index.ts свідомо НЕ компілюється в dist/, це окремий
# Vercel zero-config serverless entrypoint (не частина основного
# tsconfig.json rootDir/outDir), тому TS-компілятор при локальному
# запуску кладе .js/.js.map ПОРУЧ із джерелом за замовчуванням — Vercel
# бачить ОБИДВА файли з однаковою назвою без розширення (api/index) і
# не може вирішити, який використати. Ці 2 рядки — не про "build
# output взагалі" (те вже покрито apps/api/dist/ вище), а саме про
# цю конкретну, раніше НЕ захищену теку.
apps/api/api/*.js
apps/api/api/*.js.map

# Prisma
packages/db/node_modules/
packages/db/dist/

# Логи
*.log
npm-debug.log*

# OS/редактори
.DS_Store
.vscode/
.idea/

# Тимчасові файли збірки
*.tsbuildinfo

# Vercel
.vercel/
